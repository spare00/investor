# =============================================================================
# Investor — environment configuration
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=UTC

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://investor:investor@localhost:5432/investor
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Trading mode (FAIL CLOSED: live requires dual confirmation) ---
# PAPER is the only safe default. Live trading stays disabled unless BOTH
# LIVE_TRADING_ENABLED=true AND LIVE_TRADING_CONFIRMATION_TOKEN matches the
# expected token below. A single flag is intentionally insufficient.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION_TOKEN=
EXPECTED_LIVE_CONFIRMATION_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- Phase 5 broker / paper execution (safe defaults) ---
# Agent firm: CIO decides trades. Unlock paper with ORDERS+AUTOMATED.
# REQUIRE_MANUAL_ORDER_APPROVAL is an optional ops brake, not the firm model.
BROKER_PROVIDER=mock
BROKER_ENVIRONMENT=paper
ENABLE_BROKER_CONNECTION=false
ENABLE_BROKER_ORDERS=false
ENABLE_AUTOMATED_EXECUTION=false
REQUIRE_MANUAL_ORDER_APPROVAL=false
ENABLE_LIVE_TRADING=false
ENABLE_SHORT_SELLING=false
ENABLE_EXTENDED_HOURS_ORDERS=false
BROKER_REQUEST_TIMEOUT_SECONDS=10
BROKER_QUERY_MAX_RETRIES=2
BROKER_RETRY_BACKOFF_SECONDS=2
# Periodic recon when ENABLE_SCHEDULER + (ENABLE_BROKER_CONNECTION or ENABLE_BROKER_ORDERS)
BROKER_RECONCILIATION_INTERVAL_SECONDS=60
ORDER_APPROVAL_EXPIRY_MINUTES=10
ORDER_SUBMISSION_REVALIDATION_MAX_AGE_SECONDS=15
MAX_ORDER_SLIPPAGE_BPS=30
MAX_ORDER_SPREAD_BPS=50
CANCEL_OPEN_ORDERS_AT_CLOSE=true
EMERGENCY_STOP_CANCEL_OPEN_ORDERS=true
EMERGENCY_STOP_CLOSE_POSITIONS=false
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# Prefer ALPACA_SECRET_KEY alias; leave blank in example
ALPACA_SECRET_KEY=
MOCK_BROKER_SEED=42

# --- Alpaca Paper Trading ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# LLM spend guard: monthly AUD is primary. Daily token/call auto-split across
# trading days when LLM_DAILY_* = 0. Soft warn at 80%; hard-stop when exhausted.
LLM_BUDGET_ENFORCE=true
LLM_MONTHLY_AUD_BUDGET=20
LLM_BUDGET_TRADING_DAYS_PER_MONTH=21
LLM_BUDGET_AVG_TOKENS_PER_CALL=5000
# 0 = derive from monthly AUD / trading days (recommended).
LLM_DAILY_TOKEN_BUDGET=0
LLM_DAILY_CALL_BUDGET=0
LLM_AUD_PER_USD=1.55
LLM_INPUT_USD_PER_MTOK=0.15
LLM_OUTPUT_USD_PER_MTOK=0.60
LLM_BUDGET_SOFT_LIMIT_PCT=0.8
LLM_BUDGET_STATE_PATH=.data/llm_budget_state.json

# --- News providers (swap via NEWS_PROVIDER) ---
NEWS_PROVIDER=stub
NEWS_API_KEY=
FINNHUB_API_KEY=

# --- Market data ---
MARKET_DATA_PROVIDER=alpaca
YFINANCE_ENABLED=false

# --- Risk policy (conservative defaults) ---
STARTING_CASH=25000
MAX_POSITION_PCT=10
MAX_SECTOR_PCT=30
MAX_GROSS_EXPOSURE_PCT=70
# Cap exposure within one venue book (US or AU) as % of equity.
MAX_VENUE_GROSS_PCT=50
MIN_CASH_PCT=30
RISK_PER_TRADE_PCT=0.5
DAILY_MAX_LOSS_PCT=1.5
MAX_DRAWDOWN_PCT=8
MAX_OPEN_POSITIONS=8
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_AFTER_LOSS_MINUTES=30
FORCE_CLOSE_BEFORE_MARKET_CLOSE_MINUTES=15
MAX_CONSECUTIVE_LOSSES_HALT_DAY=5
MIN_AVG_DAILY_VOLUME=1000000
MAX_BID_ASK_SPREAD_BPS=20
MIN_DATA_QUALITY_SCORE=0.6
MAX_SLIPPAGE_BPS=15
PENNY_STOCK_MAX_PRICE=5.0
ALLOW_LEVERAGED_ETFS=false

# --- Universe (AI-managed watchlist; TRADE_ALLOWLIST is seed / soft boundary) ---
# static = only TRADE_ALLOWLIST for new entries
# dynamic = Universe Manager maintains horizon groups (scalp/day/short/medium)
UNIVERSE_MODE=dynamic
UNIVERSE_FOCUS_LIMIT=12
UNIVERSE_WATCHLIST_LIMIT=40
UNIVERSE_MANAGER_ENABLED=true
UNIVERSE_ALLOW_CANDIDATE_ADDS=true
# Universe Manager LLM at most this often (days). Premarket still rebuilds focus without LLM.
UNIVERSE_REFRESH_MIN_INTERVAL_DAYS=7
# APScheduler backup poll (seconds). Default 7d; real LLM gated by min_interval_days.
UNIVERSE_REFRESH_SECONDS=604800
# Skip periodic refresh overnight (BEFORE_PREMARKET / non-trading) — saves LLM budget.
UNIVERSE_REFRESH_SESSION_ONLY=true
# Extra symbols AI may add beyond TRADE_ALLOWLIST (empty → built-in curated pool)
# UNIVERSE_CANDIDATE_POOL=XLK,JPM,XOM,NFLX
# When true, also try live quotes for symbols missing DB snapshots (stub fills in tests).
UNIVERSE_SCREENER_ENABLED=true
UNIVERSE_SCREENER_MIN_AVG_VOLUME=1000000
UNIVERSE_SCREENER_MAX_SPREAD_BPS=40
UNIVERSE_SCREENER_MIN_PRICE=5.0
UNIVERSE_SCREENER_FETCH_LIVE=false
# Pause active watchlist names that fail liquidity (holdings exempt)
UNIVERSE_SCREENER_PAUSE_ILLIQUID=true
TRADE_ALLOWLIST=SPY,QQQ,IWM,DIA,NVDA,MSFT,AMZN,GOOGL,META,AVGO,AMD,AAPL,TSLA,IONQ
# ASX entry allowlist (used when PRIMARY_VENUE=AU or OrderRequest.venue=AU)
TRADE_ALLOWLIST_AU=BHP,CBA,VAS,IOZ,NDQ,JPEQ

# --- Intraday controls ---
INTRADAY_MIN_REEVAL_SECONDS=300
INTRADAY_COOLDOWN_SECONDS=120

# --- Timezone display (storage is always UTC) ---
DISPLAY_TZ_US=America/New_York
DISPLAY_TZ_LOCAL=Australia/Brisbane

# --- Market calendar / daily workflow (Phase 3) ---
# PRIMARY_VENUE=US|AU — selects default book (calendar/currency/IB hints).
PRIMARY_VENUE=US
# Comma-separated venues the scheduler prepares (e.g. US,AU for dual-book sessions).
ENABLED_VENUES=US
MARKET_CALENDAR=NYSE
MARKET_TIMEZONE=America/New_York
OPERATOR_TIMEZONE=Australia/Brisbane
PREMARKET_PREPARATION_MINUTES_BEFORE_OPEN=180
PREMARKET_ANALYSIS_MINUTES_BEFORE_OPEN=120
PREOPEN_REVALIDATION_MINUTES_BEFORE_OPEN=10
# Fallback spacing when no active watchlist horizons (horizon + LLM budget densify/floor).
INTRADAY_REEVALUATION_INTERVAL_MINUTES=30
MIN_REEVALUATION_GAP_MINUTES=15
# Hard cap on successful CIO reanalyses per session (plan ticks ≈ 1.5× this).
MAX_INTRADAY_REANALYSES=12
CLOSING_WINDOW_MINUTES_BEFORE_CLOSE=30
POSTMARKET_REVIEW_MINUTES_AFTER_CLOSE=30
WORKFLOW_LEASE_SECONDS=300
WORKFLOW_HEARTBEAT_SECONDS=60
MAX_REVALIDATION_RETRIES=1
# Paper unattended ops: set true with PAPER_AUTOMATED + broker paper flags
ENABLE_SCHEDULER=false
ENABLE_AUTOMATED_EXECUTION=false
ENABLE_BROKER_ORDERS=false

# --- Phase 5 broker (defaults keep orders off) ---
BROKER_PROVIDER=mock
BROKER_ENVIRONMENT=paper
ENABLE_BROKER_CONNECTION=false
REQUIRE_MANUAL_ORDER_APPROVAL=false
ENABLE_LIVE_TRADING=false
ENABLE_SHORT_SELLING=false
ENABLE_EXTENDED_HOURS_ORDERS=false
EMERGENCY_STOP_CANCEL_OPEN_ORDERS=true
EMERGENCY_STOP_CLOSE_POSITIONS=false
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Phase 6 intraday (observe-only by default) ---
INTRADAY_OPERATION_MODE=OBSERVE_ONLY
ENABLE_INTRADAY_MONITORING=true
ENABLE_INTRADAY_AGENT_REANALYSIS=true
# High-importance news lookback for unattended evaluate_intraday ingest
INTRADAY_NEWS_LOOKBACK_MINUTES=90
MIN_GLOBAL_REANALYSIS_GAP_MINUTES=10
MIN_SYMBOL_REANALYSIS_GAP_MINUTES=10
MAX_SYMBOL_REANALYSES_PER_DAY=6
EVENT_DEDUPLICATION_WINDOW_SECONDS=300
POSITION_MONITOR_INTERVAL_SECONDS=60
BROKER_STREAMING_ENABLED=false
BROKER_POLLING_FALLBACK_ENABLED=true
BROKER_POLLING_INTERVAL_SECONDS=30
# Fail-closed defaults: create exit intents only. Arm these with the paper
# unattended profile (PAPER_AUTOMATED + ENABLE_BROKER_ORDERS + ENABLE_AUTOMATED_EXECUTION).
AUTO_EXECUTE_HARD_STOPS=false
AUTO_EXECUTE_FORCE_CLOSE=false
ALLOW_STOP_WIDENING=false
ALLOW_STOP_TIGHTENING=true
ALLOW_NEW_POSITIONS_IN_CLOSING_WINDOW=false
DEFAULT_CLOSING_POLICY=CLOSE_INTRADAY_ONLY
CANCEL_ENTRY_ORDERS_AT_CLOSING_WINDOW=true
OVERNIGHT_REVIEW_REQUIRED=true
POSITION_LOT_METHOD=FIFO

# --- Paper unattended profile (copy when arming; keep Live off) ---
# INTRADAY_OPERATION_MODE=PAPER_AUTOMATED
# ENABLE_SCHEDULER=true
# ENABLE_BROKER_CONNECTION=true
# ENABLE_BROKER_ORDERS=true
# ENABLE_AUTOMATED_EXECUTION=true
# REQUIRE_MANUAL_ORDER_APPROVAL=false
# ENABLE_EXTERNAL_DATA=true
# AUTO_EXECUTE_HARD_STOPS=true
# AUTO_EXECUTE_FORCE_CLOSE=true
# BROKER_PROVIDER=ibkr
# BROKER_ENVIRONMENT=paper
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002
# IBKR_CLIENT_ID=1
# IBKR_ACCOUNT=
# IBKR_DEFAULT_EXCHANGE=SMART
# IBKR_DEFAULT_CURRENCY=USD
# IBKR_ALLOW_LIVE_PORTS=false
# IBKR_MD_CLIENT_ID=11
# Legacy Alpaca (tag alpaca-paper-final):
# BROKER_PROVIDER=alpaca

SCHEDULER_ENABLED=false
PREMARKET_CRON_HOUR=8
PREMARKET_CRON_MINUTE=0
PREMARKET_CRON_TZ=America/New_York

# --- Phase 4 data layer (external APIs off by default) ---
ENABLE_EXTERNAL_DATA=false
ENABLE_NEWS_COLLECTION=false
ENABLE_MARKET_DATA_COLLECTION=false
ENABLE_SEC_COLLECTION=false
ENABLE_MACRO_COLLECTION=false
SEC_PROVIDER=sec_edgar
MACRO_PROVIDER=fixture
ECONOMIC_CALENDAR_PROVIDER=fixture
MARKET_DATA_PROVIDER_PRIORITY=fixture
NEWS_PROVIDER_PRIORITY=fixture
PROVIDER_REQUEST_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=2
PROVIDER_CIRCUIT_BREAKER_FAILURES=5
PROVIDER_CIRCUIT_BREAKER_RESET_SECONDS=300
LATEST_QUOTE_MAX_AGE_SECONDS=30
INTRADAY_BAR_MAX_AGE_SECONDS=120
PREMARKET_QUOTE_MAX_AGE_SECONDS=120
NEWS_MAX_AGE_MINUTES=1440
ECONOMIC_EVENT_MAX_DELAY_SECONDS=300
DATA_QUALITY_WARNING_THRESHOLD=0.75
DATA_QUALITY_HARD_FAIL_THRESHOLD=0.50
QUOTE_PRICE_TOLERANCE_BPS=20
BAR_VOLUME_TOLERANCE_PCT=10
MAX_NEWS_CONTEXT_ITEMS=50
MAX_NEWS_BODY_EXCERPT_CHARS=3000
MAX_SEC_CONTEXT_ITEMS=20
SEC_USER_AGENT=InvestorBot/0.9 (contact: investor-dev@example.com)

# --- Phase 7 operations / observability ---
PRIMARY_BENCHMARK=SPY
SECONDARY_BENCHMARK=QQQ
RISK_FREE_RATE_ANNUAL=0.0
MIN_PERFORMANCE_OBSERVATIONS=20
MIN_CALIBRATION_SAMPLE_SIZE=30
ENABLE_DASHBOARD=true
DASHBOARD_READ_ONLY=true
ENABLE_PROMETHEUS_METRICS=true
ENABLE_ALERTS=true
ALERT_PROVIDER=log
CRITICAL_ALERT_COOLDOWN_SECONDS=60
WARNING_ALERT_COOLDOWN_SECONDS=300
ENABLE_FAULT_INJECTION=false
ENABLE_LONG_RUNNING_SIMULATION=false
RAW_PROVIDER_PAYLOAD_RETENTION_DAYS=30
CANONICAL_MARKET_DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555
METRIC_RETENTION_DAYS=1825
PERFORMANCE_CALCULATION_VERSION=perf_v1
# Postmarket re-scores pending short/medium decision evals across this many days.
DECISION_EVAL_LOOKBACK_DAYS=90
